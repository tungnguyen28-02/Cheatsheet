<!-- ===================== BUILD CARD VIEWER ===================== -->
<div class="viewer" id="viewer">
  <div class="viewer-bar">
    <div class="vb-ic" id="vIc"></div>
    <div class="vb-tx"><b id="vTitle"></b><small id="vSub"></small></div>
    <button type="button" class="vb-close" id="vClose" aria-label="Close picture">✕</button>
  </div>
  <div class="viewer-scroll" id="vScroll">
    <img id="vImg" src="" alt="">
    <div class="viewer-tip">👆 Tap the card to zoom in on the grams · tap again to fit</div>
  </div>
  <div class="viewer-foot">
    <button type="button" class="vf-btn" id="vPrev">‹ Previous</button>
    <div class="vf-count" id="vCount"></div>
    <button type="button" class="vf-btn" id="vNext">Next ›</button>
  </div>
</div>
<script>
  // ============ BUILD CARD VIEWER (pictures live here, not in the page) ============
  const CARDS = [
    {n:1, ic:'🥗', title:'Fresh Rolls — Sesame &amp; Low Carb', facts:'110g · 12.5cm · 7 variants', src:'data:image/webp;base64,'},
    {n:2, ic:'🌯', title:'Fresh Rolls — Original', facts:'110g · 12.5cm · 7 variants', src:'data:image/webp;base64,'},
    {n:3, ic:'🥖', title:'Bánh Mì', facts:'Bottom → Up · 7 variants', src:'data:image/webp;base64,'},
    {n:4, ic:'🥟', title:'Bao', facts:'Bottom → Up · 7 variants', src:'data:image/webp;base64,'},
    {n:5, ic:'🍜', title:'Noodle Soups — Bowls', facts:'Bottom → Up · 7 variants', src:'data:image/webp;base64,'},
    {n:6, ic:'🥤', title:'Noodle Soups — Cups', facts:'Bottom → Up · 7 variants', src:'data:image/webp;base64,'},
    {n:7, ic:'🥙', title:'Gỏi — Viet Salad Bowls', facts:'Bottom → Up · 9 variants', src:'data:image/webp;base64,'},
    {n:8, ic:'🍲', title:'Bún — Noodle Salad Bowls', facts:'Bottom → Up · 8 variants', src:'data:image/webp;base64,'},
    {n:9, ic:'🍚', title:'Cơm — Rice Salad Bowls', facts:'Bottom → Up · 8 variants', src:'data:image/webp;base64,'},
    {n:10, ic:'🧂', title:'Dressing Station', facts:'12 sub-formats', src:'data:image/webp;base64,'}
  ];
  let vIndex = 0;
  const viewer = document.getElementById('viewer');
  function openCard(n){
    vIndex = Math.max(0, Math.min(CARDS.length - 1, n - 1));
    const c = CARDS[vIndex];
    document.getElementById('vIc').textContent    = c.ic;
    document.getElementById('vTitle').innerHTML   = c.title;
    document.getElementById('vSub').innerHTML     = c.facts;
    document.getElementById('vCount').textContent = 'Card ' + c.n + ' of ' + CARDS.length;
    const img = document.getElementById('vImg');
    img.src = c.src;
    img.alt = 'Build card ' + c.n;
    const sc = document.getElementById('vScroll');
    sc.classList.remove('zoomed');
    sc.scrollTop = 0; sc.scrollLeft = 0;
    viewer.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeCard(){
    viewer.classList.remove('open');
    document.body.style.overflow = '';
  }
  function stepCard(d){ openCard(((vIndex + d + CARDS.length) % CARDS.length) + 1); }
  document.getElementById('vImg').addEventListener('click', ()=>{
    const sc = document.getElementById('vScroll');
    const z = sc.classList.toggle('zoomed');
    if(z){ sc.scrollLeft = (sc.scrollWidth - sc.clientWidth) / 2; }
  });
  document.getElementById('vClose').addEventListener('click', closeCard);
  document.getElementById('vPrev').addEventListener('click', ()=>stepCard(-1));
  document.getElementById('vNext').addEventListener('click', ()=>stepCard(1));
  document.addEventListener('keydown', e=>{
    if(!viewer.classList.contains('open')) return;
    if(e.key === 'Escape') closeCard();
    if(e.key === 'ArrowLeft') stepCard(-1);
    if(e.key === 'ArrowRight') stepCard(1);
  });
  // ============ NAV DRAWER ============
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const scrim = document.getElementById('scrim');
  const drawer = document.getElementById('drawer');
  function openDrawer(){
    drawer.classList.add('open');
    scrim.classList.add('open');
  }
  function closeDrawer(){
    drawer.classList.remove('open');
    scrim.classList.remove('open');
  }
  hamburgerBtn.addEventListener('click', openDrawer);
  scrim.addEventListener('click', closeDrawer);
  // accordion: main items with subs
  document.querySelectorAll('.drawer-row[data-toggle]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const li = btn.closest('li');
      const wasOpen = li.classList.contains('open');
      document.querySelectorAll('.drawer-list > li[data-main]').forEach(el=>el.classList.remove('open'));
      if(!wasOpen) li.classList.add('open');
    });
  });
  // any leaf link closes the drawer after navigating
  document.querySelectorAll('[data-nav]').forEach(a=>{
    a.addEventListener('click', (e)=>{
      const card = a.dataset.card;
      if(card){
        e.preventDefault();
        closeDrawer();
        setTimeout(()=>openCard(parseInt(card,10)), 180);
        return;
      }
      setTimeout(closeDrawer, 250);
    });
  });
  // ============ JOB REQUEST FORM ============
  (function(){
    const JOB_WEBHOOK_URL = "https://floral-cherry-54c7.tung-nguyen28feb.workers.dev";
    const form   = document.getElementById('jobForm');
    const btn    = document.getElementById('jrSend');
    const status   = document.getElementById('jrStatus');
    const fallback = document.getElementById('jrFallback');
    const fbText   = document.getElementById('jrFallbackText');
    const copyBtn  = document.getElementById('jrCopy');
    if(!form) return;
    const fields = {
      store: {el: document.getElementById('jr-store'), wrap: document.getElementById('f-store'),
              ok: v => v.trim().length > 0},
      name:  {el: document.getElementById('jr-name'),  wrap: document.getElementById('f-name'),
              ok: v => v.trim().length >= 2},
      issue: {el: document.getElementById('jr-issue'), wrap: document.getElementById('f-issue'),
              ok: v => v.trim().length >= 10}
    };
    function setStatus(kind, msg){
      status.className = 'form-status show ' + kind;
      status.textContent = msg;
    }
    function clearStatus(){
      status.className = 'form-status';
      status.textContent = '';
    }
    Object.values(fields).forEach(f=>{
      const evt = f.el.tagName === 'SELECT' ? 'change' : 'input';
      f.el.addEventListener(evt, ()=>{
        if(f.ok(f.el.value)) f.wrap.classList.remove('invalid');
      });
    });
    function validate(){
      let firstBad = null;
      Object.values(fields).forEach(f=>{
        const good = f.ok(f.el.value);
        f.wrap.classList.toggle('invalid', !good);
        if(!good && !firstBad) firstBad = f;
      });
      if(firstBad){
        firstBad.wrap.scrollIntoView({behavior:'smooth', block:'center'});
        firstBad.el.focus({preventScroll:true});
        return false;
      }
      return true;
    }
    // Build a plain-text copy of the request, used by the fallback panel
    function asText(){
      return 'ROLL\u2019D JOB REQUEST\n'
           + 'Store: '  + fields.store.el.value.trim() + '\n'
           + 'Name: '   + fields.name.el.value.trim()  + '\n'
           + 'Issue: '  + fields.issue.el.value.trim() + '\n'
           + 'Raised: ' + new Date().toLocaleString();
    }
    function showFallback(){
      fbText.value = asText();
      fallback.classList.add('show');
    }
    function hideFallback(){ fallback.classList.remove('show'); }
    copyBtn.addEventListener('click', async ()=>{
      const text = fbText.value;
      let done = false;
      try{
        if(navigator.clipboard && window.isSecureContext){
          await navigator.clipboard.writeText(text);
          done = true;
        }
      }catch(err){ /* fall through to the manual method */ }
      if(!done){
        try{
          fbText.removeAttribute('readonly');
          fbText.select();
          fbText.setSelectionRange(0, 99999);
          done = document.execCommand('copy');
          fbText.setAttribute('readonly','readonly');
        }catch(err){ done = false; }
      }
      copyBtn.textContent = done ? '\u2713 Copied \u2014 now paste it to your manager'
                                 : 'Select the text above and copy it manually';
      setTimeout(()=>{ copyBtn.textContent = 'Copy the details'; }, 4000);
    });

    // Send once. Returns 'sent' (server confirmed), 'unconfirmed' (request left the
    // phone but the reply could not be read, e.g. no CORS header) or throws.
    async function post(mode){
      const ctrl  = new AbortController();
      const timer = setTimeout(()=>ctrl.abort(), 15000);
      try{
        const opts = {
          method: 'POST',
          headers: {'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'},
          body: payloadText,
          signal: ctrl.signal
        };
        if(mode === 'no-cors') opts.mode = 'no-cors';
        const res = await fetch(JOB_WEBHOOK_URL, opts);
        if(res.type === 'opaque') return 'unconfirmed';
        if(!res.ok){
          // The server answered and said no. That is a real failure, not a
          // CORS problem, so it must not be retried as an unreadable send.
          const bad = new Error('HTTP ' + res.status);
          bad.serverRefused = true;
          throw bad;
        }
        return 'sent';
      } finally {
        clearTimeout(timer);
      }
    }

    let payloadText = '';

    form.addEventListener('submit', async function(e){
      e.preventDefault();
      clearStatus();
      hideFallback();
      // bot filled the hidden field - pretend it worked, send nothing
      if(document.getElementById('jr-website').value.trim() !== ''){
        setStatus('ok', 'Thanks \u2014 your request has been sent.');
        form.reset();
        return;
      }
      if(!validate()) return;

      const who   = fields.name.el.value.trim();
      const store = fields.store.el.value;
      payloadText = new URLSearchParams({
        store:       store,
        name:        who,
        issue:       fields.issue.el.value.trim(),
        submittedAt: new Date().toISOString(),
        source:      'Roll\u2019d SA Manual'
      }).toString();

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Sending\u2026';

      let outcome = null;
      try{
        outcome = await post('cors');
      }catch(err){
        // Only a blocked CORS reply or a dead network is worth a second try.
        // A server that answered with an error, or a 15s timeout, is a real
        // failure - retrying blind would tell the user it probably sent.
        const worthRetry = !err.serverRefused && err.name !== 'AbortError';
        if(worthRetry){
          try{ outcome = await post('no-cors'); }
          catch(err2){ outcome = null; }
        }else{
          outcome = null;
        }
      }

      if(outcome === 'sent'){
        setStatus('ok', '\u2705 Sent. ' + who + ', your job request is logged for '
                        + store + '. Tung will pick it up.');
        form.reset();
        Object.values(fields).forEach(f=>f.wrap.classList.remove('invalid'));
      }else if(outcome === 'unconfirmed'){
        setStatus('warn', '\u2709\uFE0F Sent, but the phone could not read a reply, so it is '
                        + 'not confirmed. Copy the details below and message the manager '
                        + 'as well if you do not hear back today.');
        showFallback();
      }else{
        setStatus('err', '\u26A0\uFE0F Could not send \u2014 check your signal and press '
                        + 'Send Request again. Your answers are still here. If it keeps '
                        + 'failing, copy the details below and send them to the manager.');
        showFallback();
      }
      btn.disabled = false;
      btn.textContent = original;
    });
  })();
</script>
